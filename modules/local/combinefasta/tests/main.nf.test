// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test combinefasta
nextflow_process {

    name "Test Process COMBINEFASTA"
    script "../main.nf"
    process "COMBINEFASTA"

    tag "modules"
    tag "modules_local"
    tag "combinefasta"

    test("test-combinefasta") {

        when {
            process {
                """
                
                input[0] = [
                    [ id:'test'], // meta map
                    file(${projectDir}/tests/test_data/combinefasta, checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
                )
        }

    }

}
